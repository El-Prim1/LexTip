# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend configuration for Layer 2 translation service
# BACKEND_URL: URL of the translation proxy server
# - Development: http://localhost:3000 (default)
# - Production: Must be set explicitly (e.g., https://api.yourdomain.com)
BACKEND_URL="http://localhost:3000"

# GOOGLE_TRANSLATE_API_KEY: Google Cloud Translation API v2 key
# Stored only on the backend, never exposed to the extension
# Required for Layer 2 cloud translation
GOOGLE_TRANSLATE_API_KEY="YOUR_GOOGLE_TRANSLATE_API_KEY"

# RATE_LIMIT_PER_IP: Maximum requests per minute per IP address
# Default: 60 requests/minute
RATE_LIMIT_PER_IP="60"

# GLOBAL_DAILY_CEILING: Global daily request limit for the backend
# Default: 10,000 requests/day
# Note: In-memory counter resets on server restart (documented limitation)
GLOBAL_DAILY_CEILING="10000"

# CACHE_TTL_DAYS: Cache time-to-live in days for chrome.storage.local
# Default: 15 days (per Google Translate API terms)
CACHE_TTL_DAYS="15"

# CACHE_MAX_ENTRIES: Maximum number of entries in the translation cache
# Default: 100 entries
CACHE_MAX_ENTRIES="100"

# NODE_ENV: Environment setting
# - development: Uses localhost backend URL by default
# - production: Requires explicit BACKEND_URL
NODE_ENV="development"
