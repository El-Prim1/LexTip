# Copy this file to .env for local Docker Compose usage.
# Never commit the real .env file or any credentials.

# Languages downloaded and served by LibreTranslate (comma separated).
LT_LOAD_ONLY=en,ru

# Disable the bundled demo web UI; LexTip only needs the JSON API.
LT_DISABLE_WEB_UI=true

# Download/update the Argos models on startup.
LT_UPDATE_MODELS=true

# Bind address inside the container.
LT_HOST=0.0.0.0
LT_PORT=5000

# Optional: require an API key for /translate requests.
# Leave empty to allow anonymous access (Render free tier default).
# LT_API_KEYS=

# Optional: store the API-key database on a mounted persistent disk.
# LT_API_KEYS_DB_PATH=/data/api_keys.db
