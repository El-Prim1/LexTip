/**
 * LinguaLens - Translation Cache
 * Manages cached translations using chrome.storage.local
 * Generated by scripts/build-extension.mjs
 */

const CACHE_TTL_DAYS = {{CACHE_TTL_DAYS}};
const CACHE_MAX_ENTRIES = {{CACHE_MAX_ENTRIES}};
const CACHE_STORAGE_KEY = 'translations';

/**
 * Normalize text for cache key generation
 */
function normalizeText(text) {
  if (!text || typeof text !== 'string') return '';
  return text
    .trim()
    .toLowerCase()
    .replace(/\s+/g, ' ');
}

/**
 * Generate cache key from normalized text
 */
function cacheKey(text) {
  const normalized = normalizeText(text);
  return normalized;
}

/**
 * Check if a cache entry is expired
 */
function isExpired(entry) {
  if (!entry || !entry.timestamp) return true;
  const ttlMs = CACHE_TTL_DAYS * 24 * 60 * 60 * 1000;
  const now = Date.now();
  return (now - entry.timestamp) > ttlMs;
}

/**
 * Get cached translation
 */
async function getCachedTranslation(text) {
  try {
    const key = cacheKey(text);
    const result = await chrome.storage.local.get(CACHE_STORAGE_KEY);
    const cache = result[CACHE_STORAGE_KEY] || {};
    const entry = cache[key];

    if (!entry) {
      return null;
    }

    if (isExpired(entry)) {
      // Remove expired entry
      await removeCachedTranslation(text);
      return null;
    }

    return entry;
  } catch (error) {
    console.error('[TranslationCache] Error reading from cache:', error);
    return null;
  }
}

/**
 * Set cached translation
 */
async function setCachedTranslation(text, data) {
  try {
    const key = cacheKey(text);
    const result = await chrome.storage.local.get(CACHE_STORAGE_KEY);
    const cache = result[CACHE_STORAGE_KEY] || {};

    // Enforce max entries by evicting oldest if needed
    const entries = Object.entries(cache);
    if (entries.length >= CACHE_MAX_ENTRIES) {
      // Find oldest entry
      let oldestKey = null;
      let oldestTimestamp = Infinity;

      for (const [k, entry] of entries) {
        if (entry.timestamp && entry.timestamp < oldestTimestamp) {
          oldestTimestamp = entry.timestamp;
          oldestKey = k;
        }
      }

      if (oldestKey) {
        delete cache[oldestKey];
      }
    }

    // Add new entry
    cache[key] = {
      ...data,
      timestamp: Date.now(),
    };

    await chrome.storage.local.set({ [CACHE_STORAGE_KEY]: cache });
  } catch (error) {
    console.error('[TranslationCache] Error writing to cache:', error);
    // Don't throw - cache failures should not block translation
  }
}

/**
 * Remove cached translation
 */
async function removeCachedTranslation(text) {
  try {
    const key = cacheKey(text);
    const result = await chrome.storage.local.get(CACHE_STORAGE_KEY);
    const cache = result[CACHE_STORAGE_KEY] || {};

    if (cache[key]) {
      delete cache[key];
      await chrome.storage.local.set({ [CACHE_STORAGE_KEY]: cache });
    }
  } catch (error) {
    console.error('[TranslationCache] Error removing from cache:', error);
  }
}

/**
 * Clear all expired entries from cache
 */
async function cleanupExpiredEntries() {
  try {
    const result = await chrome.storage.local.get(CACHE_STORAGE_KEY);
    const cache = result[CACHE_STORAGE_KEY] || {};

    let cleaned = 0;
    for (const [key, entry] of Object.entries(cache)) {
      if (isExpired(entry)) {
        delete cache[key];
        cleaned++;
      }
    }

    if (cleaned > 0) {
      await chrome.storage.local.set({ [CACHE_STORAGE_KEY]: cache });
      console.log(`[TranslationCache] Cleaned up ${cleaned} expired entries`);
    }
  } catch (error) {
    console.error('[TranslationCache] Error during cleanup:', error);
  }
}

/**
 * Get cache statistics
 */
async function getCacheStats() {
  try {
    const result = await chrome.storage.local.get(CACHE_STORAGE_KEY);
    const cache = result[CACHE_STORAGE_KEY] || {};
    const entries = Object.values(cache);
    const expiredCount = entries.filter(isExpired).length;

    return {
      totalEntries: entries.length,
      expiredEntries: expiredCount,
      validEntries: entries.length - expiredCount,
      maxEntries: CACHE_MAX_ENTRIES,
      ttlDays: CACHE_TTL_DAYS,
    };
  } catch (error) {
    console.error('[TranslationCache] Error getting stats:', error);
    return {
      totalEntries: 0,
      expiredEntries: 0,
      validEntries: 0,
      maxEntries: CACHE_MAX_ENTRIES,
      ttlDays: CACHE_TTL_DAYS,
    };
  }
}

// Export for use in service worker
if (typeof module !== 'undefined' && module.exports) {
  module.exports = {
    getCachedTranslation,
    setCachedTranslation,
    removeCachedTranslation,
    cleanupExpiredEntries,
    getCacheStats,
  };
}
