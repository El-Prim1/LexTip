{
  "manifest_version": 3,
  "name": "LexTip - 3-Layer Translator",
  "version": "1.0.0",
  "description": "Instant 3-layer text translation with isolated Shadow DOM.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LexTip Settings"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/content-styles.css",
        "dictionaries/*",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
